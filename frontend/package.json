{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:callback-redirect": "node --experimental-strip-types scripts/test-post-login-redirect.ts",
    "test:session-claims": "node --experimental-strip-types scripts/test-session-claims.ts",
    "test:pain001-upload-route": "node --experimental-strip-types scripts/test-pain001-upload-route.ts",
    "test:pain001-upload-card": "node --experimental-strip-types scripts/test-pain001-upload-card.ts",
    "generate:e1-signed-fixture": "node --experimental-strip-types scripts/generate-e1-signed-fixture.ts",
    "test:smoke:d3a": "playwright test e2e/d3a-vertical-smoke.spec.ts --project=chromium",
    "test:smoke:e1-pain001": "playwright test e2e/e1-signed-pain001.spec.ts --project=e1-pain001",
    "test:smoke:e1-pain001:composed": "cd .. && dagger call smoke-signed-pain-001 --lock=frozen --progress=plain",
    "codegen:graphql": "graphql-codegen --config codegen.yml",
    "codegen:graphql:check": "pnpm run codegen:graphql && git diff --exit-code -- src/generated/graphql.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.3",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "graphql": "^16.11.0",
    "tailwindcss": "^4",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19"
    }
  }
}
